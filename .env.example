# false = live mode: customer app at "/", admin console at "/admin". true = original offline demo.
VITE_DEMO_MODE=false

# DEV: leave empty (Vite proxies /api -> VITE_DEV_PROXY_TARGET). PROD (Vercel): set to your HTTPS backend origin.
VITE_API_BASE_URL=
VITE_DEV_PROXY_TARGET=http://localhost:8081

# Optional: enables Google on BOTH customer sign-in and create-account screens.
# Use the same Web OAuth client ID configured as GOOGLE_CLIENT_ID in Spring Boot.
VITE_GOOGLE_CLIENT_ID=

# Super Admin authentication paths (password challenge -> MFA verification -> admin session).
VITE_ADMIN_LOGIN_PATH=/api/v1/admin/auth/login
VITE_ADMIN_MFA_VERIFY_PATH=/api/v1/admin/auth/mfa/verify
VITE_ADMIN_REFRESH_PATH=/api/v1/admin/auth/refresh
VITE_ADMIN_LOGOUT_PATH=/api/v1/admin/auth/logout
VITE_ADMIN_PLATFORMS_PATH=/api/v1/admin/catalog/platforms
